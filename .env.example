# CDK 배포 후 출력(Outputs)에 나온 값을 채운다.
#   cd infra && npx cdk deploy
# 이 파일을 .env 로 복사해서 사용한다.
VITE_AWS_REGION=ap-northeast-2
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_API_URL=

# AWS 를 쓰지 않고 이 컴퓨터에서만 돌리려면 아래 두 줄을 채운다.
# `npm run dev:local` 로 실행하면 이 값을 자동으로 넣어 주므로,
# 그 경우에는 이 파일을 건드릴 필요가 없다.
#VITE_LOCAL_MODE=1
#VITE_API_URL=http://localhost:8787
